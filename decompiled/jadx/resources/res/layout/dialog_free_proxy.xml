<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_proxy_dialog"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/free_proxy_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/free_proxy_subtitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_country_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <EditText
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:id="@+id/et_search_country"
            android:background="@drawable/bg_edit_dark"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/free_proxy_search_hint"
            android:maxLines="1"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/tv_no_country_match"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/premium_proxy_no_match"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_countries"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_testing_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_edit_dark"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/tv_selected_country"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/accent_selection"
                    android:id="@+id/btn_change_country"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/free_proxy_change_country"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/pb_testing"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tv_testing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_alive_proxies"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_no_results"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:id="@+id/tv_no_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/free_proxy_no_results"
                android:lineSpacingExtra="3dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_accent"
                android:id="@+id/btn_retry_test"
                android:background="@drawable/bg_btn_accent"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/free_proxy_retry"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_gravity="end"
        android:id="@+id/btn_close_dialog"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/proxy_close"/>
</LinearLayout>
