<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/btn_back"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:layout_weight="1"
            android:fontFamily="@font/fantasque_bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sectionProfile"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imgProfile"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/txtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:id="@+id/txtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/badgeMb"
                        android:background="@drawable/bg_section"
                        android:paddingLeft="14dp"
                        android:paddingTop="8dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="�� "/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/accent"
                            android:id="@+id/txtMb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fantasque_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/badgeCoins"
                        android:background="@drawable/bg_section"
                        android:paddingLeft="14dp"
                        android:paddingTop="8dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="�� "/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ffd700"
                            android:id="@+id/txtCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fantasque_bold"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:textSize="14sp"
                    android:textColor="#ff6b6b"
                    android:id="@+id/btnSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_sign_out"
                    android:fontFamily="@font/fantasque_bold"
                    android:backgroundTint="#1a1a1a"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/sectionLogin"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <com.google.android.material.button.MaterialButton
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_sign_in_google"
                    android:textAllCaps="false"
                    android:fontFamily="@font/fantasque_bold"
                    android:backgroundTint="@color/white"
                    app:icon="@drawable/icons8_google_48"
                    app:iconGravity="textStart"
                    app:iconTint="@null"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/settings_language"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textSize="14sp"
                        android:textColor="#0a0a0a"
                        android:id="@+id/btnSpanish"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="Español"
                        android:layout_weight="1"
                        android:fontFamily="@font/fantasque_bold"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/background_bar_color"/>
                    <Button
                        android:textSize="14sp"
                        android:textColor="#0a0a0a"
                        android:id="@+id/btnEnglish"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="English"
                        android:layout_weight="1"
                        android:fontFamily="@font/fantasque_bold"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/background_bar_color"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notifications"
                    android:layout_weight="1"
                    android:fontFamily="@font/fantasque_bold"/>
                <Switch
                    android:textColor="@color/white"
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/fantasque_bold"
                    android:thumbTint="@color/background_bar_color"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_viewer_embedded"
                        android:layout_weight="1"
                        android:fontFamily="@font/fantasque_bold"/>
                    <Switch
                        android:textColor="@color/white"
                        android:id="@+id/switchViewerEmbedded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:fontFamily="@font/fantasque_bold"
                        android:thumbTint="@color/background_bar_color"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/background_bar_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_viewer_embedded_hint"
                    android:fontFamily="@font/fantasque_regular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_swipe_tabs"
                        android:layout_weight="1"
                        android:fontFamily="@font/fantasque_bold"/>
                    <Switch
                        android:textColor="@color/white"
                        android:id="@+id/switchSwipeTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:fontFamily="@font/fantasque_bold"
                        android:thumbTint="@color/background_bar_color"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/background_bar_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_swipe_tabs_hint"
                    android:fontFamily="@font/fantasque_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardNotificationHistory"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notification_history"
                    android:layout_weight="1"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#cfc9e9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:fontFamily="@font/fantasque_regular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sectionSubscription"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_dialog_title_premium"
                        android:layout_weight="1"
                        android:fontFamily="@font/fantasque_bold"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#0a0a0a"
                        android:id="@+id/txtSubscriptionBadge"
                        android:background="@drawable/bg_btn_accent"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:fontFamily="@font/fantasque_bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#bbbbbb"
                    android:id="@+id/txtSubscriptionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/settings_free_version"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutSubscriptionFree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="��"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#e0e0e0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_benefit_ads_title"
                            android:fontFamily="@font/fantasque_regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="��"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#e0e0e0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_benefit_profiles_title"
                            android:fontFamily="@font/fantasque_regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="⚡"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#e0e0e0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_benefit_proxies_title"
                            android:fontFamily="@font/fantasque_regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="��"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#e0e0e0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sub_benefit_emails_title"
                            android:fontFamily="@font/fantasque_regular"/>
                    </LinearLayout>
                    <Button
                        android:textSize="14sp"
                        android:textColor="#0a0a0a"
                        android:id="@+id/btnSubscribe"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_monthly_subscription_price"
                        android:fontFamily="@font/fantasque_bold"
                        android:backgroundTint="@color/background_bar_color"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutSubscriptionPremium"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#dddddd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/settings_premium_active_desc"
                        android:fontFamily="@font/fantasque_regular"/>
                    <Button
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:id="@+id/btnManageSubscription"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/settings_manage_subscription"
                        android:fontFamily="@font/fantasque_bold"
                        android:backgroundTint="#262626"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#444444"
                android:gravity="center"
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
