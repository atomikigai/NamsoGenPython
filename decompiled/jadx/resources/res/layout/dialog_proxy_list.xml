<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="14dp"
    android:paddingRight="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:gravity="top"
        android:id="@+id/et_list"
        android:background="@drawable/bg_edit_dark"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/proxy_import_hint"
        android:minLines="6"
        android:inputType="textNoSuggestions"
        android:importantForAutofill="no"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/tv_detected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <HorizontalScrollView
        android:id="@+id/hl_countries"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_countries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <ProgressBar
        android:id="@+id/pb_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressTint="@color/accent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/tv_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_empty"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/tv_empty_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proxy_empty_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_on_accent"
            android:gravity="center"
            android:id="@+id/btn_empty_add"
            android:background="@drawable/bg_btn_accent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="@string/add_proxies"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_links"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_manual"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_manual"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_new_list"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_import_new"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_retest"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_retest"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/danger"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_clear"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_import_clear"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_retest_fails"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
