<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/tempmail1"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/temp_mail_title"
                android:layout_weight="1"
                android:fontFamily="@font/fantasque_bold"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textColorHighlight="#6633b5e5"
                    android:textColorHint="@color/white"
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_temp_username"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Spinner
                android:id="@+id/spinnerDomain"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <Button
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/btnCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_generate"
                android:fontFamily="@font/fantasque_bold"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/btnRandom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_generate_random"
                android:fontFamily="@font/fantasque_bold"
                android:layout_marginStart="8dp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tmph_clear"
                android:fontFamily="@font/fantasque_bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/selectionBar"
            android:background="@color/background_card"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/textSelectionInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/background_bar_color"
                android:id="@+id/btnCancelSelection"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                android:fontFamily="@font/fantasque_bold"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/background_bar_color"
                android:id="@+id/btnDeleteSelected"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tmph_delete_selected"
                android:fontFamily="@font/fantasque_bold"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTempMailEmails"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/textEmptyState"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/tmph_empty"
                android:fontFamily="@font/fantasque_regular"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
