<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="8dp"
    app:cardBackgroundColor="#0a0a0a"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">
    <FrameLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="#f3f3f3"
                android:id="@+id/textBatchCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:fontFamily="@font/fantasque_regular"
                android:layout_marginEnd="36dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:id="@+id/textBatchMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fantasque_regular"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/btnBatchOptions"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/ldc_history_options"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
