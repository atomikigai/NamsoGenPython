<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="14dp"
    android:paddingRight="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/proxy_type"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <RadioButton
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:id="@+id/rb_http"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/proxy_type_http"
                android:layout_weight="1"
                android:buttonTint="@color/accent"/>
            <RadioButton
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:id="@+id/rb_https"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_type_https"
                android:layout_weight="1"
                android:buttonTint="@color/accent"/>
        </RadioGroup>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <RadioButton
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:id="@+id/rb_socks5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_type_socks5"
                android:layout_weight="1"
                android:buttonTint="@color/accent"/>
            <RadioButton
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:id="@+id/rb_socks4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/proxy_type_socks4"
                android:layout_weight="1"
                android:buttonTint="@color/accent"/>
        </RadioGroup>
    </LinearLayout>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:id="@+id/et_proxy_host"
        android:background="@drawable/bg_edit_dark"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:hint="@string/proxy_host_hint"
        android:maxLines="1"
        android:inputType="text"
        android:importantForAutofill="no"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:id="@+id/et_proxy_port"
        android:background="@drawable/bg_edit_dark"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:hint="@string/proxy_port_hint"
        android:maxLines="1"
        android:maxLength="5"
        android:inputType="number"
        android:importantForAutofill="no"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:id="@+id/et_proxy_user"
        android:background="@drawable/bg_edit_dark"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:hint="@string/proxy_user_hint"
        android:maxLines="1"
        android:inputType="text"
        android:importantForAutofill="no"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:id="@+id/et_proxy_pass"
        android:background="@drawable/bg_edit_dark"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:hint="@string/proxy_pass_hint"
        android:maxLines="1"
        android:inputType="textPassword"
        android:importantForAutofill="no"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/danger"
        android:id="@+id/tv_proxy_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/accent"
        android:id="@+id/tv_import_list"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/proxy_import_link"/>
</LinearLayout>
