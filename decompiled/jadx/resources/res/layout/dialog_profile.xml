<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="8dp"
    android:paddingRight="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:id="@+id/et_profile_name"
            android:background="@drawable/bg_edit_dark"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/profile_name_hint"
            android:maxLines="1"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:id="@+id/et_profile_url"
            android:background="@drawable/bg_edit_dark"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/profile_url_hint"
            android:maxLines="1"
            android:inputType="textUri"
            android:importantForAutofill="no"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/profile_proxy_label"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_edit_dark"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tv_profile_proxy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/profile_no_proxy"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="end"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/accent_selection"
                    android:id="@+id/btn_pick_proxy"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_pick_proxy"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/accent_selection"
                    android:id="@+id/btn_pick_free_proxy"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/free_proxy_btn"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:id="@+id/btn_pick_premium_proxy"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/premium_proxy_btn"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/danger"
            android:id="@+id/btn_remove_proxy"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/profile_remove_proxy"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_on_accent"
                android:gravity="center"
                android:id="@+id/btn_save_only"
                android:background="@drawable/bg_btn_accent"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/profile_save"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_on_accent"
                android:gravity="center"
                android:id="@+id/btn_save_open"
                android:background="@drawable/bg_btn_accent"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:text="@string/profile_save_open"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
