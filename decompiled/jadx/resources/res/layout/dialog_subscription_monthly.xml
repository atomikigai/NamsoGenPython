<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_proxy_dialog"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sub_dialog_title_premium"
            android:fontFamily="@font/fantasque_bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/tvDialogReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_section"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="��"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_ads_title"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_ads_desc"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="��"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_profiles_title"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_profiles_desc"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="⚡"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_proxies_title"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_proxies_desc"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="✉️"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_emails_title"
                    android:fontFamily="@font/fantasque_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_benefit_emails_desc"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/btnSubscribe"
        android:background="@drawable/bg_btn_accent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/sub_btn_subscribe_default"
        android:fontFamily="@font/fantasque_bold"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/btnLater"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="@string/sub_btn_later"
        android:fontFamily="@font/fantasque_bold"
        style="@style/Widget.Material3.Button.TextButton"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/tvLegal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sub_legal_terms"/>
</LinearLayout>
