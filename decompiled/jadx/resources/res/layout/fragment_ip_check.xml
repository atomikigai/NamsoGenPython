<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">
        <Button
            android:textColor="@color/black"
            android:id="@+id/checkFraudButton"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ip_check_title"
            android:fontFamily="@font/fantasque_bold"
            android:backgroundTint="@color/background_bar_color"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loader"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/LayoutResult"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/scoreBar"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    app:indicatorColor="#d5c0f4"
                    app:trackColor="#33888888"
                    app:trackCornerRadius="7dp"
                    app:trackThickness="14dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="50"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="60"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="70"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="80"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="90"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="32sp"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/scoreBigTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:fontFamily="@font/fantasque_bold"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/riskTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:fontFamily="@font/fantasque_bold"/>
            <EditText
                android:textColorHighlight="#6633b5e5"
                android:gravity="start"
                android:id="@+id/ipDetailsEditText"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:hint="@string/hint_ip_details"
                android:inputType="textMultiLine"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
