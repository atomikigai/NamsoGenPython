<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_proxy_dialog"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/premium_proxy_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_user_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_edit_dark"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:id="@+id/tv_mb_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tus MB disponibles: 0 MB"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/tv_mb_expires"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:gravity="center"
            android:id="@+id/btn_buy_mb"
            android:background="@drawable/bg_btn_accent"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/premium_proxy_buy_pack"/>
    </LinearLayout>
    <EditText
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:id="@+id/et_search_country"
        android:background="@drawable/bg_edit_dark"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/premium_proxy_search_hint"
        android:maxLines="1"
        android:inputType="textNoSuggestions"
        android:importantForAutofill="no"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/pb_loading"
        android:visibility="visible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/tv_no_country"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/premium_proxy_no_match"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_countries"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_gravity="end"
        android:id="@+id/btn_close_dialog"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/proxy_close"/>
</LinearLayout>
