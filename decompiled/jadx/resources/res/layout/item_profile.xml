<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="8dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#0a0a0a"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff444444"
            android:id="@+id/tv_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_pname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:ellipsize="middle"
                android:id="@+id/tv_psub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btn_pmore"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/profiles_more"
            app:srcCompat="@drawable/ic_more"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
